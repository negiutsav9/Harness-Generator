graph TD
    %% Main workflow
    Start([START]) --> Frontend
    Frontend --> CodeEmbedding
    CodeEmbedding --> Analyzer
    Analyzer --> Junction
    Junction -->|Next function| Generator
    Junction -->|All functions done| Output
    Generator -->|Verify| CBMC
    CBMC --> Evaluator
    Evaluator -->|Needs refinement| Generator
    Evaluator -->|Function done| Junction
    Output --> End([END])

    %% Core components with RAG database
    subgraph CoreComponents[Core Components]
        STATE[State Management]
        subgraph RAG_System[RAG Database]
            RAG_CODE[Code Collection]
            RAG_PATTERNS[Pattern Collection]
            RAG_ERRORS[Error Collection]
            RAG_SOLUTIONS[Solution Collection]
        end
    end

    %% Main node descriptions
    Frontend[Frontend: Process input code]
    CodeEmbedding[Code Embedding: Create embeddings]
    Analyzer[Analyzer: Identify vulnerable functions]
    Junction[Junction: Orchestrate workflow]
    Generator[Generator: Create/refine harnesses]
    CBMC[CBMC: Verify with model checker]
    Evaluator[Evaluator: Assess results]
    Output[Output: Generate reports]

    %% Data paths (dashed lines)
    CodeEmbedding -.-|Store code| RAG_CODE
    Analyzer -.-|Query vulnerabilities| RAG_PATTERNS
    Generator -.-|Query patterns| RAG_PATTERNS
    CBMC -.-|Store errors| RAG_ERRORS
    Evaluator -.-|Store solutions| RAG_SOLUTIONS
    Output -.-|Query data| RAG_System
    
    %% State connections (code flow uses solid lines)
    STATE --- Frontend
    STATE --- CodeEmbedding
    STATE --- Analyzer
    STATE --- Junction
    STATE --- Generator
    STATE --- CBMC
    STATE --- Evaluator
    STATE --- Output

    %% Style nodes
    classDef primary fill:#d4f1f9,stroke:#05728f,stroke-width:2px;
    classDef core fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px;
    classDef rag fill:#e1d5e7,stroke:#9673a6,stroke-width:2px;
    classDef endpoint fill:#d5e8d4,stroke:#82b366,stroke-width:2px;

    class Frontend,CodeEmbedding,Analyzer,Junction,Generator,CBMC,Evaluator,Output primary;
    class STATE core;
    class RAG_System,RAG_CODE,RAG_PATTERNS,RAG_ERRORS,RAG_SOLUTIONS rag;
    class Start,End endpoint;
    
    %% Link styles
    linkStyle default stroke-width:2px;
    linkStyle 10,11,12,13,14 stroke-dasharray: 5 5;