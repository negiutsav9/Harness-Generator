    "# Node 5: Generator (LLM Agent) - Generates CBMC harnesses\n",
    "def generator_node(state: HarnessGenerationState):\n",
    "    \"\"\"Generates CBMC-compatible harnesses for the vulnerable functions.\"\"\"\n",
