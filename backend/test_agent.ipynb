    "            if match:\n",
    "                harness_code = match.group(1)\n",
    "            \n",
    "            harnesses[func_name] = harness_code\n",
    "    \n",
    "    return {\n",
    "        \"messages\": [AIMessage(content=f\"Generated harnesses for {len(harnesses)} functions.\")],\n",
    "        \"harnesses\": harnesses\n",
